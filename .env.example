# Kopier denne fila til .env.local og fyll inn verdier.

# Lokalt: en SQLite-fil i prosjektmappa.
# I produksjon (Turso): libsql://<database>-<bruker>.turso.io
DATABASE_URL=file:local.db

# Trengs bare for Turso i produksjon.
DATABASE_AUTH_TOKEN=

# Koden nye beboere må oppgi for å registrere seg. Velg noe som ikke er lett å gjette.
INVITE_CODE=endre-meg
